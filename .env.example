# --- FalkorDB (local docker: localhost:6381; FalkorDB Cloud: host/port/user/password from the console)
FALKORDB_HOST=localhost
FALKORDB_PORT=6381
# Optional, unset locally. Required for FalkorDB Cloud.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Set to true when your FalkorDB endpoint requires TLS
FALKORDB_TLS=false
# Free-tier guard: keep at most this many player worlds (least recently active are deleted)
MAX_WORLDS=20
# World that is never pruned (used for the public demo)
DEMO_PLAYER=demo
# Create the demo world on startup if it does not exist
DEMO_AUTOCREATE=false

# --- Claude (optional). Without a key the town runs in deterministic "scripted" mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# LLM_DISABLED=true   # force scripted mode even with a key

# --- HTTP
CORS_ORIGINS=*
